APP_NAME=VeriGate API
APP_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://verigate:change_this_password@localhost:5432/verigate
AUTH_SECRET_KEY=replace_with_a_long_random_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
GITHUB_WEBHOOK_SECRET=replace_with_github_webhook_secret
# Optional: required for commit statuses and PR summary comments. Never commit a real token.
# Classic PAT: repo scope (public_repo for public repositories). Fine-grained: Pull requests
# and Issues read/write permissions on the target repository.
GITHUB_TOKEN=
# Used to link a PR comment back to the verification run.
FRONTEND_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=
